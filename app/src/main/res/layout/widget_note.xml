<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tasks_background"
    android:clipToOutline="true">

    <ListView
        android:id="@+id/note_lines"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="44dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/note_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="20dp"
        android:text="Tap ⋮ to choose a note"
        android:textColor="#FFC4C9DC"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/note_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:contentDescription="Widget settings"
        android:padding="10dp"
        android:src="@drawable/ic_widget_more" />
</FrameLayout>
