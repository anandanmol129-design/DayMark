<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tasks_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/widget_tasks_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/widget_open"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Open Daymark"
            android:padding="6dp"
            android:src="@drawable/ic_widget_daymark" />

        <LinearLayout
            android:id="@+id/widget_folder"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Choose list"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_folder_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Inbox"
                android:textColor="#FF9DB8FF"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_chevron" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Add task">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_add_background"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_widget_add" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="2dp">
        <TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="bottom" android:paddingStart="14dp" android:paddingBottom="2dp" android:text="DOING 2" android:textColor="#FF9DB8FF" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" android:visibility="visible" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Review pull request" android:textColor="#FFF1F1F2" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="Today" android:textColor="#FF8A90A6" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" android:visibility="invisible" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Plan the week" android:textColor="#FFF1F1F2" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="" android:textColor="#FF8A90A6" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="26dp" android:gravity="bottom" android:paddingStart="14dp" android:paddingBottom="2dp" android:text="TO DO 3" android:textColor="#FF9DB8FF" android:textSize="11sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" android:visibility="invisible" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Buy groceries" android:textColor="#FFF1F1F2" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="Tomorrow" android:textColor="#FF8A90A6" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" android:visibility="invisible" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Call the bank" android:textColor="#FFF1F1F2" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="Yesterday" android:textColor="#FF8A90A6" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="8dp" android:src="@drawable/widget_dot" android:visibility="invisible" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Book dentist" android:textColor="#FFF1F1F2" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:text="Mon 16" android:textColor="#FF8A90A6" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
