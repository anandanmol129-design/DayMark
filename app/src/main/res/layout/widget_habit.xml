<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tasks_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/habit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/habit_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/habit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Habit"
            android:textColor="#FFF1F1F2"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/habit_flame"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_flame" />

        <TextView
            android:id="@+id/habit_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="6dp"
            android:text="0"
            android:textColor="#FFF1F1F2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/habit_check"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Check in today"
            android:padding="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/habit_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFA9AEC0"
            android:textSize="11.5sp" />

        <ImageView
            android:id="@+id/habit_menu"
            android:layout_width="30dp"
            android:layout_height="26dp"
            android:alpha="0.7"
            android:contentDescription="Widget settings"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:src="@drawable/ic_widget_more" />
    </LinearLayout>

    <ImageView
        android:id="@+id/habit_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/habit_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Tap ⋮ to choose a habit"
        android:textColor="#FFC4C9DC"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
