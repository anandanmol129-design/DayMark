<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tasks_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/widget_tasks_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/ev_open"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Open calendar"
            android:padding="6dp"
            android:src="@drawable/ic_widget_daymark" />

        <TextView
            android:id="@+id/ev_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="Today"
            android:textColor="#FF9DB8FF"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/ev_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Add event">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_add_background"
                android:importantForAccessibility="no"
                android:padding="5dp"
                android:src="@drawable/ic_widget_add" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ListView
            android:id="@+id/ev_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/ev_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:text="Nothing planned"
            android:textColor="#FF8A90A6"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
