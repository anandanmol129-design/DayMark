<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
   
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_tasks_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_tasks_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_open"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Open Daymark"
            android:padding="8dp"
            android:src="@drawable/ic_widget_daymark" />

        <LinearLayout
            android:id="@+id/widget_folder"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Widget settings"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/widget_folder_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Inbox"
                android:textColor="#FF9DB8FF"
                android:textSize="18sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_chevron" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="Add task"
            android:padding="8dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="16dp">
            <ImageView android:layout_width="44dp" android:layout_height="40dp" android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="12dp" android:paddingBottom="9dp" android:src="@drawable/ic_widget_check_off" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Buy groceries" android:textColor="#FFF1F1F2" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="16dp">
            <ImageView android:layout_width="44dp" android:layout_height="40dp" android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="12dp" android:paddingBottom="9dp" android:src="@drawable/ic_widget_check_off" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Call the bank" android:textColor="#FFF1F1F2" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="6dp" android:paddingEnd="16dp">
            <ImageView android:layout_width="44dp" android:layout_height="40dp" android:paddingStart="10dp" android:paddingTop="9dp" android:paddingEnd="12dp" android:paddingBottom="9dp" android:src="@drawable/ic_widget_check_off" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:text="Plan the week" android:textColor="#FFF1F1F2" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
